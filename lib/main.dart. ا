
import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';

const Color emerald = Color(0xFF123D35);
const Color gold = Color(0xFFC6A45C);
const Color ivory = Color(0xFFF8F4E9);
const Color darkBackground = Color(0xFF101C19);

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  final prefs = await SharedPreferences.getInstance();

  runApp(AlKumailApp(
    darkMode: prefs.getBool('darkMode') ?? false,
    fontScale: prefs.getDouble('fontScale') ?? 1.0,
    counter: prefs.getInt('tasbihCounter') ?? 0,
    favorites: prefs.getStringList('favorites') ?? [],
  ));
}

class AlKumailApp extends StatefulWidget {
  final bool darkMode;
  final double fontScale;
  final int counter;
  final List<String> favorites;

  const AlKumailApp({
    super.key,
    required this.darkMode,
    required this.fontScale,
    required this.counter,
    required this.favorites,
  });

  @override
  State<AlKumailApp> createState() => _AlKumailAppState();
}

class _AlKumailAppState extends State<AlKumailApp> {
  late bool darkMode;
  late double fontScale;
  late int counter;
  late Set<String> favorites;

  @override
  void initState() {
    super.initState();
    darkMode = widget.darkMode;
    fontScale = widget.fontScale;
    counter = widget.counter;
    favorites = widget.favorites.toSet();
  }

  Future<void> saveValue(String key, Object value) async {
    final prefs = await SharedPreferences.getInstance();

    if (value is bool) {
      await prefs.setBool(key, value);
    } else if (value is double) {
      await prefs.setDouble(key, value);
    } else if (value is int) {
      await prefs.setInt(key, value);
    } else if (value is List<String>) {
      await prefs.setStringList(key, value);
    }
  }

  void changeCounter(int value) {
    setState(() => counter = value < 0 ? 0 : value);
    saveValue('tasbihCounter', counter);
  }

  void toggleFavorite(String item) {
    setState(() {
      if (favorites.contains(item)) {
        favorites.remove(item);
      } else {
        favorites.add(item);
      }
    });
    saveValue('favorites', favorites.toList());
  }

  void changeDarkMode(bool value) {
    setState(() => darkMode = value);
    saveValue('darkMode', value);
  }

  void changeFontScale(double value) {
    setState(() => fontScale = value);
    saveValue('fontScale', value);
  }

  @override
  Widget build(BuildContext context) {
    final base = darkMode ? const Color(0xFF182520) : ivory;
    final foreground = darkMode ? Colors.white : emerald;

    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'الكُميل',
      theme: ThemeData(
        useMaterial3: true,
        brightness: darkMode ? Brightness.dark : Brightness.light,
        scaffoldBackgroundColor: base,
        colorScheme: ColorScheme.fromSeed(
          seedColor: emerald,
          brightness: darkMode ? Brightness.dark : Brightness.light,
          primary: emerald,
          secondary: gold,
        ),
        appBarTheme: AppBarTheme(
          backgroundColor: darkMode ? darkBackground : emerald,
          foregroundColor: Colors.white,
          centerTitle: true,
        ),
        textTheme: ThemeData(
          brightness: darkMode ? Brightness.dark : Brightness.light,
        ).textTheme.apply(
          fontFamily: 'Arial',
          fontSizeFactor: fontScale,
          bodyColor: foreground,
          displayColor: foreground,
        ),
      ),
      builder: (context, child) {
        return Directionality(
          textDirection: TextDirection.rtl,
          child: child!,
        );
      },
      home: MainShell(
        darkMode: darkMode,
        fontScale: fontScale,
        counter: counter,
        favorites: favorites,
        onCounterChanged: changeCounter,
        onFavoriteChanged: toggleFavorite,
        onDarkModeChanged: changeDarkMode,
        onFontScaleChanged: changeFontScale,
      ),
    );
  }
}

