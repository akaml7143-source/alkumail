class TasbihPage extends StatefulWidget {
  final int counter;
  final ValueChanged<int> onCounterChanged;

  const TasbihPage({
    super.key,
    required this.counter,
    required this.onCounterChanged,
  });

  @override
  State<TasbihPage> createState() => _TasbihPageState();
}

class _TasbihPageState extends State<TasbihPage> {
  int mode = 0;
  int step = 0;

  final List<String> phrases = [
    'الله أكبر',
    'الحمد لله',
    'سبحان الله',
  ];

  final List<int> targets = [34, 33, 33];

  String get currentPhrase {
    if (mode == 1) return 'تسبيح مفتوح';
    return phrases[step];
  }

  int get currentTarget {
    if (mode == 1) return 0;
    return targets[step];
  }

  void count() {
    final next = widget.counter + 1;
    widget.onCounterChanged(next);

    if (mode == 0 && next >= currentTarget) {
      if (step < 2) {
        setState(() => step++);
      } else {
        setState(() => step = 0);
        showDialog(
          context: context,
          builder: (_) => AlertDialog(
            title: const Text('أحسنت'),
            content: const Text('اكتمل تسبيح الزهراء عليها السلام.'),
            actions: [
              TextButton(
                onPressed: () => Navigator.pop(context),
                child: const Text('حسناً'),
              ),
            ],
          ),
        );
      }
    }
  }

  void reset() {
    showDialog(
      context: context,
      builder: (_) => AlertDialog(
        title: const Text('تصفير العدّاد'),
        content: const Text('هل تريد تصفير عدّاد التسبيح؟'),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: const Text('إلغاء'),
          ),
          TextButton(
            onPressed: () {
              widget.onCounterChanged(0);
              setState(() => step = 0);
              Navigator.pop(context);
            },
            child: const Text('تصفير'),
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final remaining = mode == 0
        ? (currentTarget - widget.counter).clamp(0, currentTarget)
        : 0;

    return Padding(
      padding: const EdgeInsets.all(20),
      child: Column(
        children: [
          const SizedBox(height: 12),
          SegmentedButton<int>(
            segments: const [
              ButtonSegment(value: 0, label: Text('تسبيح الزهراء')),
              ButtonSegment(value: 1, label: Text('تسبيح مفتوح')),
            ],
            selected: {mode},
            onSelectionChanged: (value) {
              setState(() {
                mode = value.first;
                step = 0;
              });
              widget.onCounterChanged(0);
            },
          ),
          const Spacer(),
          Text(
            currentPhrase,
            style: const TextStyle(
              fontSize: 29,
              fontWeight: FontWeight.bold,
              color: gold,
            ),
          ),
          const SizedBox(height: 16),
          Text(
            '${widget.counter}',
            style: const TextStyle(
              fontSize: 65,
              fontWeight: FontWeight.bold,
            ),
          ),
          if (mode == 0)
            Text(
              'المتبقي: $remaining',
              style: const TextStyle(fontSize: 16),
            ),
          const SizedBox(height: 30),
          InkWell(
            onTap: count,
            borderRadius: BorderRadius.circular(100),
            child: Container(
              width: 190,
              height: 190,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                gradient: const LinearGradient(
                  colors: [emerald, Color(0xFF285B4D)],
                ),
                border: Border.all(color: gold, width: 5),
                boxShadow: [
                  BoxShadow(
                    color: emerald.withOpacity(.2),
                    blurRadius: 18,
                    spreadRadius: 3,
                  ),
                ],
              ),
              child: const Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  Icon(Icons.touch_app, color: gold, size: 42),
                  SizedBox(height: 8),
                  Text(
                    'اضغط للتسبيح',
                    style: TextStyle(
                      color: Colors.white,
                      fontSize: 18,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ],
              ),
            ),
          ),
          const Spacer(),
          OutlinedButton.icon(
            onPressed: reset,
            icon: const Icon(Icons.refresh),
            label: const Text('تصفير العدّاد'),
          ),
          const SizedBox(height: 15),
        ],
      ),
    );
  }
}

